{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "map-boundary-builder",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "map_boundary_builder/web_assets"
  },
  "routes": [
    { "pattern": "mapboundary.app", "custom_domain": true },
    { "pattern": "www.mapboundary.app", "custom_domain": true }
  ],
  "containers": [
    {
      "class_name": "MapBoundaryContainer",
      "image": "./Dockerfile",
      "instance_type": "standard",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MAP_BOUNDARY",
        "class_name": "MapBoundaryContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MapBoundaryContainer"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
