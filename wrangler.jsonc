{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "map-boundary-builder",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "map_boundary_builder/web_assets",
    // Bound so the Worker can answer index.html's /static/* references from
    // the asset bundle instead of waking the container for CSS/JS.
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "mapboundary.app", "custom_domain": true },
    { "pattern": "www.mapboundary.app", "custom_domain": true }
  ],
  "containers": [
    {
      "class_name": "MapBoundaryContainer",
      "image": "./Dockerfile",
      "instance_type": "standard-1",
      // A single named instance ("primary") serves everything; a second slot
      // only adds a warm spare that is billed like the first.
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MAP_BOUNDARY",
        "class_name": "MapBoundaryContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MapBoundaryContainer"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
